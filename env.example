# Copy this file to .env and fill in your values:  copy env.example .env

# ---------------- LLM provider ----------------
# openai | azure | anthropic | ollama | mock
LLM_PROVIDER=openai
# Leave EMPTY to enable smart per-task model routing with the provider's default tiers.
# Setting it pins every tier to this one model (Azure: deployment name).
LLM_MODEL=

# ---------------- Smart model routing ----------------
# auto  = each call goes to a small / medium / large model based on task type, complexity, retries and budget
# fixed = one model for every call
LLM_ROUTING=auto
# Optional tier overrides: "model" (uses LLM_PROVIDER) or "provider:model" (mix providers, e.g. free local small tier)
# Defaults - openai: gpt-4o-mini / gpt-4.1-mini / gpt-4.1 ; anthropic: claude-3-5-haiku / claude-sonnet-4 / claude-opus-4
#            ollama: qwen2.5-coder 7b / 14b / 32b ; azure: AZURE_OPENAI_DEPLOYMENT for all tiers unless set
# LLM_TIER_SMALL=ollama:qwen2.5-coder:7b
# LLM_TIER_MEDIUM=gpt-4.1-mini
# LLM_TIER_LARGE=gpt-4.1
# Total token budget per run (0 = unlimited). At 80% usage calls are capped at medium, at 95% at small.
TOKEN_BUDGET=0
# Price table for cost estimates, USD per 1M tokens [input, output]; merged with built-in defaults
# LLM_PRICES={"my-deployment": [2.0, 8.0]}

# ---------------- Technology decisions ----------------
# Mandatory technology constraints. Leave empty to let the Solution Architect choose the whole stack.
# TECH_PREFERENCES=Java 21 + Spring Boot backend, Angular frontend, PostgreSQL, deploy to Azure AKS
TECH_PREFERENCES=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8000
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT=600
LLM_MAX_RETRIES=3

# Optional per-role model pin (beats routing), "model" or "provider:model":
# LLM_MODEL_SOLUTION_ARCHITECT=gpt-4.1
# LLM_MODEL_TECHNICAL_WRITER=gpt-4o-mini

# OpenAI (or any OpenAI-compatible server: Groq, OpenRouter, LM Studio, vLLM ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# Anthropic
ANTHROPIC_API_KEY=

# Ollama (free, local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=32768

# ---------------- Delivery process ----------------
OUTPUT_DIR=output
# Allow agents to execute build/test commands in the generated project
ALLOW_EXECUTION=false
# Allow DevOps to run deployment commands (e.g. docker compose up -d)
ALLOW_DEPLOY=false
COMMAND_TIMEOUT=900
MAX_QA_ITERATIONS=3
MAX_QUESTIONS_PER_TASK=3
# Characters of code/artifacts each agent may see per call (raise for large-context models)
MAX_CONTEXT_CHARS=60000
INTERACTIVE=false
